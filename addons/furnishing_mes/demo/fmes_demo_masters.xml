            <field name="color">4</field>
        </record>
        <record id="shift_c" model="fmes.shift">
            <field name="name">Shift C</field>
            <field name="code">C</field>
            <field name="sequence">30</field>
            <field name="start_time">22.0</field>
            <field name="end_time">6.0</field>
            <field name="break_minutes">30</field>
            <field name="color">9</field>
        </record>

