<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Mock plant dataset - departments, shifts, equipment and machines

            Stands in for what ERP 10.8 will eventually supply: customer master,
            item master, BOMs, sales orders and work orders (Requirement 11,
            deferred). It lives in demo/ and NOT in data/, so a production
            install without demo data gets none of it, and the customer's
            real master data is loaded by import instead.

            Shape follows assumptions A1-A7 in
            docs/15-open-questions-and-assumptions.md: three 8-hour shifts, six
            departments, fifteen machines, twenty items in four families.
            Every output rate is a plausible placeholder awaiting customer
            confirmation (question Q5).
        -->
        <!-- ==================== Departments (A3) ==================== -->
        <record id="dept_cutting" model="hr.department">
            <field name="name">Cutting</field>
        </record>
        <record id="dept_edge_banding" model="hr.department">
            <field name="name">Edge Banding</field>
        </record>
        <record id="dept_cnc" model="hr.department">
            <field name="name">CNC / Drilling</field>
        </record>
        <record id="dept_assembly" model="hr.department">
            <field name="name">Assembly</field>
        </record>
        <record id="dept_finishing" model="hr.department">
            <field name="name">Finishing</field>
        </record>
        <record id="dept_packing" model="hr.department">
            <field name="name">Packing</field>
        </record>

        <!-- ==================== Shifts (A1) ==================== -->
        <record id="shift_a" model="fmes.shift">
            <field name="name">Shift A</field>
            <field name="code">A</field>
            <field name="sequence">10</field>
            <field name="start_time">6.0</field>
            <field name="end_time">14.0</field>
            <field name="break_minutes">30</field>
            <field name="color">1</field>
        </record>
        <record id="shift_b" model="fmes.shift">
            <field name="name">Shift B</field>
            <field name="code">B</field>
            <field name="sequence">20</field>
