<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            One reusable template, referenced by any alert rule that wants
            email (deliverable 5). Its subject/colour band already vary per
            alert, since they render straight from the fmes.alert record's
            own severity and subject rather than being hard-coded per type —
            genuinely "per alert type" in what a recipient sees, without nine
            near-identical HTML files to keep in sync. Only ever sent for
            critical-severity alerts (assumption A34); the engine enforces
            that gate, not the template itself.
        -->
        <record id="mail_template_fmes_alert" model="mail.template">
            <field name="name">Furnishing MES: Alert Notification</field>
            <field name="model_id" ref="model_fmes_alert"/>
            <field name="subject">[Furnishing MES] {{ object.subject }}</field>
            <field name="body_html" type="html">
<div style="margin:0; padding:0; font-family: Arial, sans-serif;">
    <t t-set="fmes_alert_color" t-value="'#dc3545' if object.severity == 'critical' else ('#f0ad4e' if object.severity == 'warning' else '#3498db')"/>
    <div t-attf-style="padding:12px 16px; color:#fff; background:{{fmes_alert_color}};">
        <strong t-out="object.severity and object.severity.upper() or ''"/>
        <t t-out="' — ' + (object.rule_id.name or '')"/>
    </div>
    <div style="padding:16px; font-size:13px; color:#333;">
        <p><t t-out="object.subject or ''"/></p>
        <t t-out="object.body or ''"/>
        <p style="margin-top:16px; color:#888; font-size:11px;">
            Triggered <t t-out="object.triggered_on or ''"/>. Open the Alert
            Center in Furnishing MES to acknowledge or resolve.
        </p>
    </div>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>
