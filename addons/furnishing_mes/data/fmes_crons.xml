<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Scheduled actions.

            noupdate="1" so a plant that retimes a job keeps its change across
            upgrades.
        -->

        <record id="cron_fmes_generate_daily_entries" model="ir.cron">
            <field name="name">Furnishing MES: prepare today's production entries</field>
            <field name="model_id" ref="model_fmes_production_entry"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_daily_entries()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="nextcall"
                   eval="(DateTime.now().replace(hour=0, minute=15, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

    </data>
</odoo>
