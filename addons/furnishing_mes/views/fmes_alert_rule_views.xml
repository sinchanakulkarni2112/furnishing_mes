<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================ -->
        <!--  Alert Rules (Plant Manager only)                            -->
        <!-- ============================================================ -->
        <record id="fmes_alert_rule_view_list" model="ir.ui.view">
            <field name="name">fmes.alert.rule.list</field>
            <field name="model">fmes.alert.rule</field>
            <field name="arch" type="xml">
                <list string="Alert Rules" decoration-muted="not active">
                    <field name="name"/>
                    <field name="alert_type"/>
                    <field name="scope"/>
                    <field name="operator"/>
                    <field name="threshold"/>
                    <field name="threshold_uom" optional="show"/>
                    <field name="severity" widget="badge"
                           decoration-danger="severity == 'critical'"
                           decoration-warning="severity == 'warning'"/>
                    <field name="cooldown_minutes" optional="show"/>
                    <field name="active" optional="hide" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="fmes_alert_rule_view_form" model="ir.ui.view">
            <field name="name">fmes.alert.rule.form</field>
            <field name="model">fmes.alert.rule</field>
            <field name="arch" type="xml">
                <form string="Alert Rule">
                    <sheet>
                        <widget name="web_ribbon" title="Archived"
                                bg_color="text-bg-danger" invisible="active"/>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group string="Condition">
                                <field name="alert_type"/>
                                <field name="operator"/>
                                <field name="threshold"/>
                                <field name="threshold_uom"/>
                                <field name="severity"/>
                                <field name="active"/>
                            </group>
                            <group string="Scope">
                                <field name="scope"/>
                                <field name="department_ids" widget="many2many_tags"
                                       invisible="scope != 'department'"/>
                                <field name="workcenter_ids" widget="many2many_tags"
                                       invisible="scope != 'workcenter'"/>
                                <field name="cooldown_minutes"/>
                            </group>
                        </group>
                        <group string="Notification">
                            <group>
                                <field name="recipient_group_ids" widget="many2many_tags"/>
                                <field name="recipient_user_ids" widget="many2many_tags"/>
                            </group>
                            <group>
                                <field name="notify_activity"/>
                                <field name="notify_discuss"/>
                                <field name="notify_email"/>
                                <field name="mail_template_id"
                                       invisible="not notify_email"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_fmes_alert_rule" model="ir.actions.act_window">
            <field name="name">Alert Rules</field>
            <field name="res_model">fmes.alert.rule</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Configure an alert rule
                </p>
                <p>
                    A Plant Manager tunes a threshold here — no code change
                    needed to retime or rescope an alert.
                </p>
            </field>
        </record>


    </data>
</odoo>
