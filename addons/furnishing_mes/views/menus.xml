        <!-- ============================================================ -->
        <!--  Upgrade drift repair — clearing stale child-menu groups      -->
        <!-- ============================================================ -->
        <!--
            A previous load left supervisor+manager groups_id on several
            child menus (DB verifier: Monitoring, WorkCentre Downtimes,
            Maintenance and Configuration children carry an extra [68,69]).
            A <menuitem> tag without a `groups` attribute does NOT clear an
            already-set groups_id on upgrade — Odoo's XML loader only
            applies fields present in the tag — and an Operator (group 67)
            has no intersection with [68,69], so each drifted child stays
            invisible to them however the tab above it is widened. These
            <record> forms clear the stored groups explicitly; the affected
            children then inherit their (already-correct) parent restriction,
            exactly as their tags intend. Worst case for Configuration:
            the cleared leaves fall back to the Plant Manager gateway of
            menu_fmes_configuration, which is their intended restriction.
        -->
        <record id="menu_fmes_executive_dashboard" model="ir.ui.menu">
