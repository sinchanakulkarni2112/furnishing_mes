<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
            Furnishing MES menu structure, per docs/05-ui-ux-design.md section 2.

            The section menus are declared here so the information architecture
            is fixed from the start and later phases only add leaf items. Odoo
            hides a parent menu that has no visible children, so the sections
            that are still empty simply do not render yet.

            Operators see only Production > Shop Floor Terminal (Phase 4).
            The `groups` attribute is a usability filter; actual access control
            lives in ir.model.access.csv and ir.rule.
        -->

        <!-- ============================================================ -->
        <!--  Root                                                        -->
        <!-- ============================================================ -->
        <menuitem id="menu_fmes_root"
                  name="Furnishing MES"
                  web_icon="furnishing_mes,static/description/icon.png"
                  sequence="10"/>

        <!-- ============================================================ -->
        <!--  Sections                                                    -->
        <!-- ============================================================ -->

        <!-- Dashboard — Phase 10 -->
        <menuitem id="menu_fmes_dashboard"
                  name="Dashboard"
                  parent="menu_fmes_root"
                  sequence="10"
                  groups="furnishing_mes.group_fmes_supervisor"/>

        <!-- Planning — Phase 3 -->
        <menuitem id="menu_fmes_planning"
                  name="Planning"
                  parent="menu_fmes_root"
                  sequence="20"
                  groups="furnishing_mes.group_fmes_supervisor"/>

        <!-- Production — Phase 4 (operators enter here) -->
        <menuitem id="menu_fmes_production"
                  name="Production"
                  parent="menu_fmes_root"
                  sequence="30"/>

        <!-- Downtime — Phase 5 -->
        <menuitem id="menu_fmes_downtime"
                  name="Downtime"
                  parent="menu_fmes_root"
                  sequence="40"
                  groups="furnishing_mes.group_fmes_supervisor"/>

        <menuitem id="menu_fmes_downtime_events"
                  name="Downtime Events"
                  parent="menu_fmes_downtime"
                  action="action_fmes_downtime_events"
                  sequence="10"/>

        <menuitem id="menu_fmes_downtime_approval_queue"
                  name="Approval Queue"
                  parent="menu_fmes_downtime"
                  action="action_fmes_downtime_approval_queue"
                  sequence="20"/>

        <menuitem id="menu_fmes_downtime_loss_analysis"
                  name="Loss Analysis"
                  parent="menu_fmes_downtime"
                  action="action_fmes_downtime_report"
                  sequence="30"/>

        <!-- Maintenance — Phase 7 -->
        <menuitem id="menu_fmes_maintenance"
                  name="Maintenance"
                  parent="menu_fmes_root"
                  sequence="50"
                  groups="furnishing_mes.group_fmes_supervisor"/>

        <!-- Manpower — Phase 8 -->
        <menuitem id="menu_fmes_manpower"
                  name="Manpower"
                  parent="menu_fmes_root"
                  sequence="60"
                  groups="furnishing_mes.group_fmes_supervisor"/>

        <!-- Backlog — Phase 9 -->
        <menuitem id="menu_fmes_backlog"
                  name="Backlog"
                  parent="menu_fmes_root"
                  sequence="70"
                  groups="furnishing_mes.group_fmes_supervisor"/>

        <!-- Alerts — Phase 11 -->
        <menuitem id="menu_fmes_alerts"
                  name="Alerts"
                  parent="menu_fmes_root"
                  sequence="80"
                  groups="furnishing_mes.group_fmes_supervisor"/>

        <menuitem id="menu_fmes_alert_center"
                  name="Alert Center"
                  parent="menu_fmes_alerts"
                  action="action_fmes_alert"
                  sequence="10"/>

        <menuitem id="menu_fmes_alert_rules"
                  name="Alert Rules"
                  parent="menu_fmes_alerts"
                  action="action_fmes_alert_rule"
                  sequence="20"
                  groups="furnishing_mes.group_fmes_manager"/>

        <!-- Reports — Phase 12 -->
        <menuitem id="menu_fmes_reports"
                  name="Reports"
                  parent="menu_fmes_root"
                  sequence="90"
                  groups="furnishing_mes.group_fmes_supervisor"/>

        <!-- Configuration — Plant Manager only -->
        <menuitem id="menu_fmes_configuration"
                  name="Configuration"
                  parent="menu_fmes_root"
                  sequence="100"
                  groups="furnishing_mes.group_fmes_manager"/>

        <!-- ============================================================ -->
        <!--  Planning                                                    -->
        <!-- ============================================================ -->

        <menuitem id="menu_fmes_plans"
                  name="Production Plans"
                  parent="menu_fmes_planning"
                  action="action_fmes_production_plan"
                  sequence="10"/>

        <menuitem id="menu_fmes_generate_plan"
                  name="Generate Plan"
                  parent="menu_fmes_planning"
                  action="action_fmes_plan_generator"
                  sequence="20"/>

        <menuitem id="menu_fmes_scheduling_board"
                  name="Scheduling Board"
                  parent="menu_fmes_planning"
                  action="action_fmes_scheduling_board"
                  sequence="30"/>

        <menuitem id="menu_fmes_plan_lines"
                  name="Plan Lines"
                  parent="menu_fmes_planning"
                  action="action_fmes_plan_line"
                  sequence="40"/>

        <menuitem id="menu_fmes_carry_forward"
                  name="Carry Forward"
                  parent="menu_fmes_planning"
                  action="action_fmes_carry_forward"
                  sequence="50"/>

        <!-- ============================================================ -->
        <!--  Dashboard                                                   -->
        <!-- ============================================================ -->

        <menuitem id="menu_fmes_executive_dashboard"
                  name="Executive Dashboard"
                  parent="menu_fmes_dashboard"
                  action="action_fmes_executive_dashboard"
                  sequence="10"/>

        <menuitem id="menu_fmes_live_status"
                  name="Live Production Status"
                  parent="menu_fmes_dashboard"
                  action="action_fmes_live_status"
                  sequence="20"/>

        <menuitem id="menu_fmes_production_report"
                  name="Production Output"
                  parent="menu_fmes_dashboard"
                  action="action_fmes_production_report"
                  sequence="25"/>

        <menuitem id="menu_fmes_utilization_report"
                  name="Machine Utilisation"
                  parent="menu_fmes_dashboard"
                  action="action_fmes_utilization_report"
                  sequence="30"/>

        <menuitem id="menu_fmes_manpower_impact_report"
                  name="Manpower Impact"
                  parent="menu_fmes_dashboard"
                  action="action_fmes_manpower_impact_report"
                  sequence="40"/>

        <!-- ============================================================ -->
        <!--  Production                                                  -->
        <!--                                                              -->
        <!--  The terminal is the only item an operator sees; everything  -->
        <!--  else here is supervisor and above.                          -->
        <!-- ============================================================ -->

        <menuitem id="menu_fmes_terminal"
                  name="Shop Floor Terminal"
                  parent="menu_fmes_production"
                  action="action_fmes_shopfloor_terminal"
                  sequence="10"/>

        <menuitem id="menu_fmes_entries"
                  name="Production Entries"
                  parent="menu_fmes_production"
                  action="action_fmes_production_entry"
                  sequence="20"
                  groups="furnishing_mes.group_fmes_supervisor"/>

        <menuitem id="menu_fmes_approval_queue"
                  name="Approval Queue"
                  parent="menu_fmes_production"
                  action="action_fmes_approval_queue"
                  sequence="30"
                  groups="furnishing_mes.group_fmes_supervisor"/>

        <menuitem id="menu_fmes_planned_vs_actual"
                  name="Planned vs Actual"
                  parent="menu_fmes_production"
                  action="action_fmes_planned_vs_actual"
                  sequence="40"
                  groups="furnishing_mes.group_fmes_supervisor"/>

        <menuitem id="menu_fmes_import_output"
                  name="Import Daily Output"
                  parent="menu_fmes_production"
                  action="action_fmes_production_import"
                  sequence="50"
                  groups="furnishing_mes.group_fmes_supervisor"/>

        <menuitem id="menu_fmes_import_batches"
                  name="Import Batches"
                  parent="menu_fmes_production"
                  action="action_fmes_import_batch"
                  sequence="60"
                  groups="furnishing_mes.group_fmes_manager"/>

        <!-- ============================================================ -->
        <!--  Maintenance                                                 -->
        <!-- ============================================================ -->

        <menuitem id="menu_fmes_maintenance_schedules"
                  name="Preventive Schedules"
                  parent="menu_fmes_maintenance"
                  action="action_fmes_maintenance_schedule"
                  sequence="10"/>

        <menuitem id="menu_fmes_maintenance_requests"
                  name="Maintenance Requests"
                  parent="menu_fmes_maintenance"
                  action="maintenance.hr_equipment_request_action_cal"
                  sequence="20"/>

        <menuitem id="menu_fmes_maintenance_kpis"
                  name="Maintenance KPIs"
                  parent="menu_fmes_maintenance"
                  action="action_fmes_maintenance_report"
                  sequence="30"/>

        <!-- ============================================================ -->
        <!--  Manpower                                                    -->
        <!-- ============================================================ -->

        <menuitem id="menu_fmes_operator_roster"
                  name="Operator Roster"
                  parent="menu_fmes_manpower"
                  action="action_fmes_operator_allocation"
                  sequence="10"/>

        <menuitem id="menu_fmes_manpower_logs"
                  name="Manpower Logs"
                  parent="menu_fmes_manpower"
                  action="action_fmes_manpower_log"
                  sequence="20"/>

        <menuitem id="menu_fmes_manpower_impact"
                  name="Manpower Impact"
                  parent="menu_fmes_manpower"
                  action="action_fmes_manpower_impact_report"
                  sequence="30"/>

        <!-- ============================================================ -->
        <!--  Backlog                                                     -->
        <!-- ============================================================ -->

        <menuitem id="menu_fmes_backlog_overview"
                  name="Backlog Overview"
                  parent="menu_fmes_backlog"
                  action="action_fmes_backlog_overview"
                  sequence="10"/>

        <menuitem id="menu_fmes_backlog_blocked"
                  name="Blocked Orders"
                  parent="menu_fmes_backlog"
                  action="action_fmes_blocked_orders"
                  sequence="20"/>

        <menuitem id="menu_fmes_backlog_delayed"
                  name="Delayed Orders"
                  parent="menu_fmes_backlog"
                  action="action_fmes_delayed_orders"
                  sequence="30"/>

        <!-- ============================================================ -->
        <!--  Configuration                                               -->
        <!-- ============================================================ -->

        <menuitem id="menu_fmes_config_shifts"
                  name="Shifts"
                  parent="menu_fmes_configuration"
                  action="action_fmes_shift"
                  sequence="10"/>

        <menuitem id="menu_fmes_config_machines"
                  name="Machines"
                  parent="menu_fmes_configuration"
                  action="action_fmes_machine_master"
                  sequence="20"/>

        <menuitem id="menu_fmes_config_capacity"
                  name="Capacity Matrix"
                  parent="menu_fmes_configuration"
                  action="action_fmes_capacity_matrix"
                  sequence="30"/>

        <menuitem id="menu_fmes_config_equipment"
                  name="Equipment"
                  parent="menu_fmes_configuration"
                  action="maintenance.hr_equipment_action"
                  sequence="40"/>

        <menuitem id="menu_fmes_config_departments"
                  name="Departments"
                  parent="menu_fmes_configuration"
                  action="hr.hr_department_tree_action"
                  sequence="50"/>

        <menuitem id="menu_fmes_config_loss_reasons"
                  name="Downtime Reasons"
                  parent="menu_fmes_configuration"
                  action="action_fmes_loss_reason"
                  sequence="60"/>

    </data>
</odoo>
