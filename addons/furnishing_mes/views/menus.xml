        <!--
            Furnishing MES menu structure — reorganised to match the
            customer's own navigation sketch (workflow-first: Production
            Planning / Monitoring / Orders / WorkCentre Downtimes /
            Maintenance / Inventory / Analytics / Notifications) instead of
            the original phase-by-phase grouping. No new screens, models or
            security behaviour here — every action= below already existed
            before this reorganisation; only parents, labels and sequences
            moved. Two exceptions, both pure read-only lookups into data
            Odoo already tracks natively: the four Inventory shortcuts.

            Operators land on the Shop Floor Terminal (the Shift Logs >
            Shop Floor Terminal path is deliberately free of any `groups`
            restriction all the way from the root). They may also browse
            every top-level tab: Production Planning and Orders carry no
            group at all, and Monitoring / WorkCentre Downtimes /
            Maintenance / Inventory / Analytics / Notifications carry
            `groups="...group_fmes_operator"` so the tabs render in the
            purple bar — a folder only shows when at least one of its own
            descendant tabs is visible to the user (Odoo 18
            menu-visibility semantics), and the read ACLs below decide
            which of those open on a model an Operator can actually read.
            Support Tickets stays Supervisor-and-above and Configuration
            stays Plant-Manager-only (explicit user decision), so neither
            renders for an Operator. The `groups` attribute is a usability
            filter; actual access control lives in ir.model.access.csv and
            ir.rule.

            no action= on the root menu itself, by design: Odoo's webclient
            picks a user's default app on login by calling
            menuService.selectMenu() on their FIRST root app menu, and a
            hardcoded action there would drop EVERYONE who clicks the app
            tile into the same screen — a Supervisor or Plant Manager would
            get the Shop Floor Terminal instead of their own start point.
            Leaving the root actionless restores Odoo's native "first valid
            tab" behaviour, which lands each role on the tab that is
            actually valid for them.
        -->

        <menuitem id="menu_fmes_root"
                  name="Furnishing MES"
                  web_icon="furnishing_mes,static/description/icon.png"
                  sequence="10"/>

        <!-- ============================================================ -->
        <!--  Sections                                                    -->
        <!-- ============================================================ -->

        <!-- 1. Production Planning — deliberately NO group restriction;
             Shift Logs > Shop Floor Terminal, one level below, is how an
             Operator reaches the terminal. Full <record> form, not the
             <menuitem> shortcut: this menu previously carried
             groups="...supervisor" (from when it was named "Planning"),
             and removing an attribute from a <menuitem> tag does NOT
             clear an already-set field on upgrade — Odoo's XML loader
             only applies fields present in the tag, it never resets ones
             that are merely absent. groups_id must be cleared explicitly
             or an Operator silently loses this menu (and the Terminal
             beneath it) again. -->
        <record id="menu_fmes_planning" model="ir.ui.menu">
            <field name="name">Production Planning</field>
            <field name="parent_id" ref="menu_fmes_root"/>
            <field name="sequence">20</field>
            <field name="groups_id" eval="[(5, 0, 0)]"/>
        </record>

        <!--
            Production Schedule — the doc's own Production Planning
            section says this data "should be visible to Employee,
            Plant Manager and Supervisor" (docs/`Product visualization`),
            so unlike Output Tracking and Manpower just below, this one
            carries no group of its own; only Generate Plan and Plan
            Lines (the editing tools) and Production Plans (their own
            management list) stay Supervisor/Manager-only below —
            Scheduling Board, the actual "Today's/Weekly/Monthly
            Schedule" view, is where the doc's requirement is met.
            Operators already hold read-only ACL on
            fmes.production.plan and .plan.line (perm_write is 0), so
            no new ACL is needed — only the menu was hiding this.
            Full <record> form, not the <menuitem> shortcut: this menu
            previously carried groups="...supervisor", and removing an
            attribute from a <menuitem> tag does not clear it on
            upgrade — groups_id must be cleared explicitly, same fix
            already applied to menu_fmes_planning and menu_fmes_backlog.
        -->
        <record id="menu_fmes_planning_schedule" model="ir.ui.menu">
            <field name="name">Production Schedule</field>
            <field name="parent_id" ref="menu_fmes_planning"/>
            <field name="sequence">10</field>
            <field name="groups_id" eval="[(5, 0, 0)]"/>
        </record>

