        <!--  Sections                                                    -->
        <!-- ============================================================ -->

        <!-- 1. Production Planning — deliberately NO group restriction;
             Shift Logs > Shop Floor Terminal, one level below, is how an
             Operator reaches the terminal. Full <record> form, not the
             <menuitem> shortcut: this menu previously carried
             groups="...supervisor" (from when it was named "Planning"),
             and removing an attribute from a <menuitem> tag does NOT
             clear an already-set field on upgrade — Odoo's XML loader
             only applies fields present in the tag, it never resets ones
             that are merely absent. groups_id must be cleared explicitly
             or an Operator silently loses this menu (and the Terminal
             beneath it) again. -->
        <record id="menu_fmes_planning" model="ir.ui.menu">
            <field name="name">Production Planning</field>
            <field name="parent_id" ref="menu_fmes_root"/>
            <field name="sequence">20</field>
            <field name="groups_id" eval="[(5, 0, 0)]"/>
        </record>

