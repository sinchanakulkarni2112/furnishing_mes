<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
            Furnishing MES menu structure — reorganised to match the
            customer's own navigation sketch (workflow-first: Production
            Planning / Monitoring / Orders / WorkCentre Downtimes /
            Maintenance / Inventory / Analytics / Notifications) instead of
            the original phase-by-phase grouping. No new screens, models or
            security behaviour here — every action= below already existed
            before this reorganisation; only parents, labels and sequences
            moved. Two exceptions, both pure read-only lookups into data
            Odoo already tracks natively: the four Inventory shortcuts.

            Operators still see only Production Planning > Shift Logs >
            Shop Floor Terminal. That path is deliberately left without a
            `groups` restriction at every level from the root down to the
            Terminal leaf — Production Planning itself carries none, so an
            Operator can descend into it at all; Production Schedule,
            Output Tracking and Manpower (the other three Planning
            sub-folders) each carry their own `groups="...supervisor"` so
            an Operator sees only the one sub-folder meant for them. The
            `groups` attribute is a usability filter; actual access control
            lives in ir.model.access.csv and ir.rule.
        -->

        <!-- ============================================================ -->
        <!--  Root                                                        -->
        <!-- ============================================================ -->
        <!--
            action= here matters beyond "what happens if you click the app
            icon itself": Odoo's webclient picks a user's default app on
            login by calling menuService.selectMenu() on their FIRST root
            app menu, and that method is a silent no-op if the root menu
            has no actionID of its own — every native Odoo app (Discuss,
            Settings, ...) sets one for exactly this reason. A single
            hardcoded client action here does not work, though: it would
            apply to EVERYONE who clicks the app icon directly, not just
            an Operator landing for the first time — a Supervisor or Plant
            Manager clicking the app tile itself (not a specific tab) would
            also get dropped straight into the Shop Floor Terminal, which
            is wrong for them. A server action picks the right one per
            role instead: Operator gets the Terminal (their only screen
            anyway), Supervisor and Plant Manager get the Executive
            Dashboard. sudo() on the lookups is deliberate and safe — this
            only reads which ACTION record to hand back, never any
            business data, and an Operator has no read access to
            ir.actions.client themselves to even look this up unsudo'd.
        -->
        <!--
            model_id below is not about what the action operates on: this
            code touches no records at all, but Odoo's own run() still
            gates a server action on write access to that model, so it has
            to be something every one of our three roles can genuinely
            write to. res.users (the obvious "no real model" choice) was
            tried first and failed for all three roles with an AccessError
            (only Administration/Access Rights can write res.users);
            fmes.production.entry is a model every role already has write
            access to for real, unrelated reasons, so it costs nothing
            extra to reuse here as the gate.
        -->
        <record id="action_fmes_root_landing" model="ir.actions.server">
            <field name="name">Furnishing MES Landing</field>
            <field name="model_id" ref="model_fmes_production_entry"/>
            <field name="state">code</field>
            <field name="code">
if env.user.has_group('furnishing_mes.group_fmes_supervisor'):
    action = env.ref('furnishing_mes.action_fmes_executive_dashboard').sudo().read()[0]
else:
    action = env.ref('furnishing_mes.action_fmes_shopfloor_terminal').sudo().read()[0]
            </field>
        </record>

        <menuitem id="menu_fmes_root"
                  name="Furnishing MES"
                  web_icon="furnishing_mes,static/description/icon.png"
                  action="action_fmes_root_landing"
                  sequence="10"/>

        <!-- ============================================================ -->
        <!--  Sections                                                    -->
        <!-- ============================================================ -->

        <!-- 1. Production Planning — deliberately NO group restriction;
             Shift Logs > Shop Floor Terminal, one level below, is how an
             Operator reaches the terminal. Full <record> form, not the
             <menuitem> shortcut: this menu previously carried
             groups="...supervisor" (from when it was named "Planning"),
             and removing an attribute from a <menuitem> tag does NOT
             clear an already-set field on upgrade — Odoo's XML loader
             only applies fields present in the tag, it never resets ones
             that are merely absent. groups_id must be cleared explicitly
             or an Operator silently loses this menu (and the Terminal
             beneath it) again. -->
        <record id="menu_fmes_planning" model="ir.ui.menu">
            <field name="name">Production Planning</field>
            <field name="parent_id" ref="menu_fmes_root"/>
            <field name="sequence">20</field>
            <field name="groups_id" eval="[(5, 0, 0)]"/>
        </record>

        <menuitem id="menu_fmes_planning_schedule"
                  name="Production Schedule"
                  parent="menu_fmes_planning"
                  sequence="10"
                  groups="furnishing_mes.group_fmes_supervisor"/>

        <menuitem id="menu_fmes_planning_output"
