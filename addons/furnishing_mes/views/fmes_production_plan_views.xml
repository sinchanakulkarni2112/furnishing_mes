<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

                <!-- ============================================================ -->
        <!--  Plan                                                        -->
        <!-- ============================================================ -->
        <record id="fmes_plan_view_list" model="ir.ui.view">
            <field name="name">fmes.production.plan.list</field>
            <field name="model">fmes.production.plan</field>
            <field name="arch" type="xml">
                <list string="Production Plans" sample="1"
                      decoration-muted="state == 'cancelled'"
                      decoration-success="state == 'released'"
                      decoration-danger="capacity_utilization_pct &gt; 100">
                    <field name="name"/>
                    <field name="plan_type"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="line_count"/>
                    <field name="total_planned_qty" sum="Quantity"/>
                    <field name="total_planned_hours" sum="Hours"
                           widget="float_time"/>
                    <field name="capacity_utilization_pct" widget="percentage"
                           optional="show"/>
                    <field name="overloaded_line_count" optional="hide"/>
                    <field name="generated_by" optional="hide"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'released'"
                           decoration-info="state == 'confirmed'"/>
                    <field name="company_id" groups="base.group_multi_company"
                           optional="hide"/>
                </list>
            </field>
        </record>

        <record id="fmes_plan_view_form" model="ir.ui.view">
            <field name="name">fmes.production.plan.form</field>
            <field name="model">fmes.production.plan</field>
            <field name="arch" type="xml">
                <form string="Production Plan">
                    <header>
                        <button name="action_confirm" type="object"
                                string="Confirm" class="btn-primary"
                                invisible="state != 'draft'"/>
                        <button name="action_release" type="object"
                                string="Release to Shop Floor"
                                class="btn-primary"
                                invisible="state != 'confirmed'"
                                help="Pushes the planned dates onto the manufacturing and work orders."/>
                        <button name="action_done" type="object" string="Mark Done"
                                invisible="state not in ('released', 'in_progress')"/>
                        <button name="action_open_board" type="object"
                                string="Scheduling Board" class="btn-secondary"
                                invisible="not id"/>
                        <button name="action_export_xlsx" type="object"
                                string="Export Excel" class="btn-secondary"
                                invisible="not id"/>
                        <button name="action_reset_to_draft" type="object"
                                string="Reset to Draft"
                                invisible="state in ('draft', 'cancelled')"/>
                        <button name="action_cancel" type="object" string="Cancel"
                                invisible="state in ('done', 'cancelled')"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,confirmed,released,done"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_lines" type="object"
                                    class="oe_stat_button" icon="fa-list">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="line_count"/>
                                    </span>
                                    <span class="o_stat_text">Lines</span>
                                </div>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <group string="Period">
                                <field name="plan_type"/>
                                <field name="date_from"/>
                                <field name="date_to"/>
                                <field name="department_ids"
                                       widget="many2many_tags"
                                       placeholder="All departments"/>
                                <field name="company_id"
                                       groups="base.group_multi_company"/>
                            </group>
                            <group string="Load">
                                <field name="total_planned_qty"/>
                                <field name="total_planned_hours"
                                       widget="float_time"/>
                                <field name="total_available_hours"
                                       widget="float_time"/>
                                <field name="capacity_utilization_pct"
                                       widget="percentage"/>
                                <field name="overloaded_line_count"/>
                                <field name="generated_by"/>
                            </group>
                        </group>

                        <div class="alert alert-warning" role="alert"
                             invisible="capacity_utilization_pct &lt;= 100">
                            This plan is loaded beyond the available capacity.
                            Extend the period, add a shift, or move work to
                            another machine.
                        </div>
                        <div class="alert alert-info" role="status"
                             invisible="not unscheduled_demand_note">
                            <field name="unscheduled_demand_note" readonly="1"
                                   nolabel="1"/>
                        </div>

                        <notebook>
                            <page string="Plan Lines" name="lines">
                                <field name="line_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="date"/>
                                        <field name="shift_id"/>
                                        <field name="workcenter_id"/>
                                        <field name="product_id"/>
                                        <field name="planned_qty"/>
                                        <field name="planned_hours"
                                               widget="float_time"/>
                                        <field name="output_rate"
                                               optional="hide"/>
                                        <field name="planned_manpower"
                                               optional="hide"/>
                                        <field name="production_id"
                                               optional="show"/>
                                        <field name="date_deadline"
                                               optional="hide"/>
                                        <field name="source"/>
                                        <field name="state"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Notes" name="notes">
                                <field name="note"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="fmes_plan_view_search" model="ir.ui.view">
            <field name="name">fmes.production.plan.search</field>
            <field name="model">fmes.production.plan</field>
            <field name="arch" type="xml">
                <search string="Production Plans">
                    <field name="name"/>
                    <field name="department_ids"/>
                    <filter name="filter_draft" string="Draft"
                            domain="[('state', '=', 'draft')]"/>
                    <filter name="filter_released" string="Released"
                            domain="[('state', 'in', ('released', 'in_progress'))]"/>
                    <filter name="filter_overloaded" string="Over Capacity"
                            domain="[('capacity_utilization_pct', '&gt;', 100)]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_state" string="Status"
                                context="{'group_by': 'state'}"/>
                        <filter name="group_type" string="Plan Type"
                                context="{'group_by': 'plan_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ============================================================ -->
        <!--  Actions                                                     -->
        <!-- ============================================================ -->
        <record id="action_fmes_production_plan" model="ir.actions.act_window">
            <field name="name">Production Plans</field>
            <field name="res_model">fmes.production.plan</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="fmes_plan_view_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Generate your first production plan
                </p>
                <p>
                    The planning engine reads open manufacturing orders and the
                    machine capacity matrix, then builds a machine-wise,
                    shift-wise schedule that fits the capacity actually
                    available.
                </p>
            </field>
        </record>

        <!-- The Scheduling Board is a client action, not a model window: it
             belongs to the planning area, so it stays here next to the plan
             it is generated from. -->
        <record id="action_fmes_scheduling_board" model="ir.actions.client">
            <field name="name">Scheduling Board</field>
            <field name="tag">fmes_scheduling_board</field>
        </record>

    </data>
</odoo>
