<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="fmes_maintenance_schedule_view_list" model="ir.ui.view">
            <field name="name">fmes.maintenance.schedule.list</field>
            <field name="model">fmes.maintenance.schedule</field>
            <field name="arch" type="xml">
                <list string="Preventive Maintenance Schedules" sample="1"
                      decoration-danger="next_due_date and next_due_date &lt; context_today().strftime('%Y-%m-%d')"
                      decoration-muted="state != 'active'">
                    <field name="name"/>
                    <field name="equipment_id"/>
                    <field name="workcenter_id" optional="show"/>
                    <field name="trigger_type"/>
                    <field name="interval_number" optional="hide"/>
                    <field name="interval_unit" optional="hide"/>
                    <field name="usage_threshold_hours" optional="hide"/>
                    <field name="last_done_date" optional="show"/>
                    <field name="next_due_date"/>
                    <field name="lead_time_days" optional="hide"/>
                    <field name="maintenance_team_id" optional="show"/>
                    <field name="request_count" optional="show"/>
                    <field name="state"/>
                    <field name="company_id" groups="base.group_multi_company"
                           optional="hide"/>
                </list>
            </field>
        </record>

        <record id="fmes_maintenance_schedule_view_form" model="ir.ui.view">
            <field name="name">fmes.maintenance.schedule.form</field>
            <field name="model">fmes.maintenance.schedule</field>
            <field name="arch" type="xml">
                <form string="Preventive Maintenance Schedule">
                    <header>
                        <field name="state" widget="statusbar"
                               statusbar_visible="active,paused,archived"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_requests" type="object"
                                    class="oe_stat_button" icon="fa-wrench">
                                <field name="request_count" widget="statinfo"
                                       string="Requests"/>
                            </button>
                        </div>
                        <group>
                            <group string="Equipment">
                                <field name="name" readonly="1"/>
                                <field name="equipment_id"
                                       options="{'no_create': True}"/>
                                <field name="workcenter_id" readonly="1"/>
                                <field name="maintenance_team_id"/>
                            </group>
                            <group string="Trigger">
                                <field name="trigger_type"/>
                                <field name="interval_number"
                                       invisible="trigger_type != 'time_based'"/>
                                <field name="interval_unit"
                                       invisible="trigger_type != 'time_based'"/>
                                <field name="usage_threshold_hours"
                                       invisible="trigger_type != 'usage_based'"/>
                                <field name="lead_time_days"/>
                                <field name="estimated_duration_hours"/>
                            </group>
                        </group>
                        <group>
                            <group string="Cycle">
                                <field name="last_done_date"/>
                                <field name="next_due_date"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Checklist" name="checklist">
                                <field name="checklist_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="is_mandatory"/>
                                        <field name="expected_value"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="fmes_maintenance_schedule_view_search" model="ir.ui.view">
            <field name="name">fmes.maintenance.schedule.search</field>
            <field name="model">fmes.maintenance.schedule</field>
            <field name="arch" type="xml">
                <search string="Preventive Maintenance Schedules">
                    <field name="name"/>
                    <field name="equipment_id"/>
                    <field name="workcenter_id"/>
                    <filter name="filter_active" string="Active"
                            domain="[('state', '=', 'active')]"/>
                    <filter name="filter_overdue" string="Overdue"
                            domain="[('next_due_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                    <separator/>
                    <filter name="filter_time_based" string="Time-Based"
                            domain="[('trigger_type', '=', 'time_based')]"/>
                    <filter name="filter_usage_based" string="Usage-Based"
                            domain="[('trigger_type', '=', 'usage_based')]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_equipment" string="Equipment"
                                context="{'group_by': 'equipment_id'}"/>
                        <filter name="group_state" string="Status"
                                context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_fmes_maintenance_schedule" model="ir.actions.act_window">
            <field name="name">Preventive Maintenance Schedules</field>
            <field name="res_model">fmes.maintenance.schedule</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_filter_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Set up a preventive maintenance schedule
                </p>
                <p>
                    A schedule is a template — it never appears on anyone's work
                    queue by itself. The
                    "Furnishing MES: generate preventive maintenance requests"
                    scheduled action turns a due schedule into a real
                    maintenance request, lead_time_days before it falls due.
                </p>
            </field>
        </record>

    </data>
</odoo>
