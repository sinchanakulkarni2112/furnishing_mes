<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="fmes_support_ticket_view_list" model="ir.ui.view">
            <field name="name">fmes.support.ticket.list</field>
            <field name="model">fmes.support.ticket</field>
            <field name="arch" type="xml">
                <list string="Support Tickets"
                      decoration-danger="priority == 'high' and state not in ('resolved', 'closed')"
                      decoration-muted="state in ('resolved', 'closed')">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="subject"/>
                    <field name="category"/>
                    <field name="priority" widget="badge"
                           decoration-danger="priority == 'high'"/>
                    <field name="assigned_to" optional="show"/>
                    <field name="state" widget="badge"
                           decoration-danger="state == 'new'"
                           decoration-info="state == 'in_progress'"
                           decoration-warning="state == 'waiting_customer'"
                           decoration-success="state in ('resolved', 'closed')"/>
                    <field name="create_date" optional="show"/>
                </list>
            </field>
        </record>

        <record id="fmes_support_ticket_view_kanban" model="ir.ui.view">
            <field name="name">fmes.support.ticket.kanban</field>
            <field name="model">fmes.support.ticket</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column">
                    <field name="state"/>
                    <field name="priority"/>
                    <templates>
                        <t t-name="card">
                            <div t-attf-class="fmes-ticket-card fmes-ticket-#{record.priority.raw_value}">
                                <div class="fw-bold"><field name="subject"/></div>
                                <div class="text-muted small">
                                    <field name="partner_id"/> · <field name="category"/>
                                </div>
                                <div class="mt-1">
                                    <span class="badge text-bg-secondary">
                                        <field name="name"/>
                                    </span>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="fmes_support_ticket_view_form" model="ir.ui.view">
            <field name="name">fmes.support.ticket.form</field>
            <field name="model">fmes.support.ticket</field>
            <field name="arch" type="xml">
                <form string="Support Ticket">
                    <header>
                        <button name="action_start" type="object"
                                string="Start" invisible="state != 'new'"/>
                        <button name="action_wait_customer" type="object"
                                string="Waiting on Customer"
                                invisible="state not in ('in_progress',)"/>
                        <button name="action_resolve" type="object"
                                string="Resolve" class="oe_highlight"
                                invisible="state in ('resolved', 'closed')"/>
                        <button name="action_close" type="object"
                                string="Close" invisible="state == 'closed'"/>
                        <button name="action_reopen" type="object"
                                string="Reopen"
                                invisible="state not in ('resolved', 'closed')"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="new,in_progress,waiting_customer,resolved"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="subject"/></h1>
                            <field name="name" readonly="1"/>
                        </div>
                        <group>
                            <group>
                                <field name="partner_id"/>
                                <field name="category"/>
                                <field name="priority"/>
                            </group>
                            <group>
                                <field name="assigned_to"/>
                                <field name="sale_order_id"/>
                                <field name="production_id"/>
                                <field name="closed_on" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                        <group invisible="not resolution and state not in ('resolved', 'closed')">
                            <field name="resolution"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="fmes_support_ticket_view_search" model="ir.ui.view">
            <field name="name">fmes.support.ticket.search</field>
            <field name="model">fmes.support.ticket</field>
            <field name="arch" type="xml">
                <search string="Support Tickets">
                    <field name="name"/>
                    <field name="subject"/>
                    <field name="partner_id"/>
                    <filter name="filter_open" string="Open"
                            domain="[('state', 'not in', ('resolved', 'closed'))]"/>
                    <filter name="filter_unassigned" string="Unassigned"
                            domain="[('assigned_to', '=', False)]"/>
                    <filter name="filter_mine" string="Assigned to Me"
                            domain="[('assigned_to', '=', uid)]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_state" string="Status"
                                context="{'group_by': 'state'}"/>
                        <filter name="group_category" string="Category"
                                context="{'group_by': 'category'}"/>
                        <filter name="group_assigned" string="Assigned To"
                                context="{'group_by': 'assigned_to'}"/>
                        <filter name="group_partner" string="Customer"
                                context="{'group_by': 'partner_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_fmes_support_ticket" model="ir.actions.act_window">
            <field name="name">Support Tickets</field>
            <field name="res_model">fmes.support.ticket</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="search_view_id" ref="fmes_support_ticket_view_search"/>
            <field name="context">{'search_default_filter_open': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No support tickets — nothing open right now
                </p>
            </field>
        </record>

    </data>
</odoo>
