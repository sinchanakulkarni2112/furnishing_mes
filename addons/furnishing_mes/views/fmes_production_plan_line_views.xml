<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

<!-- ============================================================ -->
        <!--  Plan lines                                                  -->
        <!-- ============================================================ -->
        <record id="fmes_plan_line_view_list" model="ir.ui.view">
            <field name="name">fmes.production.plan.line.list</field>
            <field name="model">fmes.production.plan.line</field>
            <field name="arch" type="xml">
                <list string="Plan Lines" sample="1" multi_edit="1"
                      decoration-muted="state == 'cancelled'"
                      decoration-success="state == 'done'"
                      decoration-warning="state == 'partial'"
                      decoration-bf="priority == '1'">
                    <field name="sequence" widget="handle"/>
                    <field name="date"/>
                    <field name="shift_id"/>
                    <field name="workcenter_id"/>
                    <field name="department_id" optional="show"/>
                    <field name="product_id"/>
                    <field name="planned_qty" sum="Planned"/>
                    <field name="qty_done" sum="Produced" optional="hide"/>
                    <field name="remaining_qty" sum="Remaining" optional="hide"/>
                    <field name="planned_hours" sum="Hours" widget="float_time"/>
                    <field name="output_rate" optional="hide"/>
                    <field name="changeover_minutes" optional="hide"/>
                    <field name="planned_manpower" optional="hide"/>
                    <field name="production_id" optional="show"/>
                    <field name="workorder_id" optional="hide"/>
                    <field name="date_deadline" optional="show"/>
                    <field name="source" optional="show"/>
                    <field name="priority" optional="hide"/>
                    <field name="state"/>
                    <field name="plan_id" optional="hide"/>
                    <field name="company_id" groups="base.group_multi_company"
                           optional="hide"/>
                </list>
            </field>
        </record>

        <record id="fmes_plan_line_view_form" model="ir.ui.view">
            <field name="name">fmes.production.plan.line.form</field>
            <field name="model">fmes.production.plan.line</field>
            <field name="arch" type="xml">
                <form string="Plan Line">
                    <sheet>
                        <group>
                            <group string="Slot">
                                <field name="plan_id"/>
                                <field name="date"/>
                                <field name="shift_id"/>
                                <field name="workcenter_id"/>
                                <field name="department_id"/>
                            </group>
                            <group string="Work">
                                <field name="product_id"/>
                                <field name="planned_qty"/>
                                <field name="qty_done"/>
                                <field name="remaining_qty"/>
                                <field name="production_id"/>
                                <field name="workorder_id"/>
                                <field name="date_deadline"/>
                            </group>
                        </group>
                        <group>
                            <group string="Sizing">
                                <field name="output_rate"/>
                                <field name="planned_hours" widget="float_time"/>
                                <field name="changeover_minutes"/>
                                <field name="planned_manpower"/>
                            </group>
                            <group string="Status">
                                <field name="state"/>
                                <field name="priority"/>
                                <field name="source"/>
                                <field name="carry_forward_from_id"
                                       invisible="source != 'carry_forward'"/>
                                <field name="sequence"/>
                            </group>
                        </group>
                        <field name="note" placeholder="Notes for the shop floor."/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="fmes_plan_line_view_search" model="ir.ui.view">
            <field name="name">fmes.production.plan.line.search</field>
            <field name="model">fmes.production.plan.line</field>
            <field name="arch" type="xml">
                <search string="Plan Lines">
                    <field name="workcenter_id"/>
                    <field name="product_id"/>
                    <field name="production_id"/>
                    <field name="plan_id"/>
                    <field name="department_id"/>
                    <filter name="filter_today" string="Today"
                            domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                    <filter name="filter_pending" string="Pending"
                            domain="[('state', '=', 'pending')]"/>
                    <filter name="filter_carry_forward" string="Carried Forward"
                            domain="[('source', '=', 'carry_forward')]"/>
                    <filter name="filter_urgent" string="Urgent"
                            domain="[('priority', '=', '1')]"/>
                    <separator/>
                    <filter name="filter_late" string="Past Deadline"
                            domain="[('date_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_date" string="Date"
                                context="{'group_by': 'date'}"/>
                        <filter name="group_shift" string="Shift"
                                context="{'group_by': 'shift_id'}"/>
                        <filter name="group_machine" string="Machine"
                                context="{'group_by': 'workcenter_id'}"/>
                        <filter name="group_department" string="Department"
                                context="{'group_by': 'department_id'}"/>
                        <filter name="group_product" string="Product"
                                context="{'group_by': 'product_id'}"/>
                        <filter name="group_state" string="Status"
                                context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="fmes_plan_line_view_pivot" model="ir.ui.view">
            <field name="name">fmes.production.plan.line.pivot</field>
            <field name="model">fmes.production.plan.line</field>
            <field name="arch" type="xml">
                <pivot string="Planned Load" sample="1">
                    <field name="workcenter_id" type="row"/>
                    <field name="date" type="col"/>
                    <field name="planned_hours" type="measure"/>
                    <field name="planned_qty" type="measure"/>
                </pivot>
            </field>
        </record>

        <record id="fmes_plan_line_view_graph" model="ir.ui.view">
            <field name="name">fmes.production.plan.line.graph</field>
            <field name="model">fmes.production.plan.line</field>
            <field name="arch" type="xml">
                <graph string="Planned Load" type="bar" sample="1">
                    <field name="workcenter_id"/>
                    <field name="planned_hours" type="measure"/>
                </graph>
            </field>
        </record>


        <!-- ============================================================ -->
        <!--  Actions                                                     -->
        <!-- ============================================================ -->
        <record id="action_fmes_plan_line" model="ir.actions.act_window">
            <field name="name">Plan Lines</field>
            <field name="res_model">fmes.production.plan.line</field>
            <field name="view_mode">list,pivot,graph,form</field>
            <field name="search_view_id" ref="fmes_plan_line_view_search"/>
            <field name="context">{'search_default_group_machine': 1}</field>
        </record>

        <record id="action_fmes_carry_forward" model="ir.actions.act_window">
            <field name="name">Carry Forward Lines</field>
            <field name="res_model">fmes.production.plan.line</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('source', '=', 'carry_forward')]</field>
            <field name="search_view_id" ref="fmes_plan_line_view_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Nothing has been carried forward
                </p>
                <p>
                    When a released plan leaves work unfinished, the next
                    planning run brings it forward automatically, ahead of new
                    orders.
                </p>
            </field>
        </record>

    </data>
</odoo>
