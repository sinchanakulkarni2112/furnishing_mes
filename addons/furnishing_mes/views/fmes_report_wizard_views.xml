<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="fmes_report_wizard_view_form" model="ir.ui.view">
            <field name="name">fmes.report.wizard.form</field>
            <field name="model">fmes.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Generate Report">
                    <group>
                        <group>
                            <field name="report_type"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="format" widget="radio"/>
                        </group>
                        <group>
                            <field name="department_ids" widget="many2many_tags"/>
                            <field name="workcenter_ids" widget="many2many_tags"/>
                            <field name="shift_id"/>
                            <field name="product_id"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_generate" type="object"
                                string="Generate" class="btn-primary"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- One action per menu shortcut (docs/05 IA), each pre-selecting a
             default report_type. The wizard's own dropdown can still switch
             to any of the ten from any entry point. -->
        <record id="action_fmes_report_daily_production" model="ir.actions.act_window">
            <field name="name">Daily Production Report</field>
            <field name="res_model">fmes.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'default_report_type': 'daily_production'}</field>
        </record>

        <record id="action_fmes_report_machine_utilisation" model="ir.actions.act_window">
            <field name="name">Machine Utilisation Report</field>
            <field name="res_model">fmes.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'default_report_type': 'machine_utilisation'}</field>
        </record>

        <record id="action_fmes_report_downtime" model="ir.actions.act_window">
            <field name="name">Downtime Report</field>
            <field name="res_model">fmes.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'default_report_type': 'downtime'}</field>
        </record>

        <record id="action_fmes_report_backlog" model="ir.actions.act_window">
            <field name="name">Backlog &amp; Carry Forward</field>
            <field name="res_model">fmes.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'default_report_type': 'backlog'}</field>
        </record>

        <record id="action_fmes_report_maintenance" model="ir.actions.act_window">
            <field name="name">Maintenance Report</field>
            <field name="res_model">fmes.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'default_report_type': 'maintenance'}</field>
        </record>

        <record id="action_fmes_report_productivity" model="ir.actions.act_window">
            <field name="name">Productivity Report</field>
            <field name="res_model">fmes.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'default_report_type': 'productivity'}</field>
        </record>

        <record id="action_fmes_report_exception" model="ir.actions.act_window">
            <field name="name">Exception Report</field>
            <field name="res_model">fmes.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'default_report_type': 'exception'}</field>
        </record>

        <record id="action_fmes_report_monthly_mis" model="ir.actions.act_window">
            <field name="name">Monthly MIS</field>
            <field name="res_model">fmes.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'default_report_type': 'monthly_mis'}</field>
        </record>

    </data>
</odoo>
