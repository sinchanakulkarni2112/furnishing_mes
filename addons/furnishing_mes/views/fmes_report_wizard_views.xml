<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="fmes_report_wizard_view_form" model="ir.ui.view">
            <field name="name">fmes.report.wizard.form</field>
            <field name="model">fmes.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Generate Report">
                    <group>
                        <group>
                            <field name="report_type"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="format" widget="radio"/>
                        </group>
                        <group>
                            <field name="department_ids" widget="many2many_tags"/>
                            <field name="workcenter_ids" widget="many2many_tags"/>
                            <field name="shift_id"/>
                            <field name="product_id"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_generate" type="object"
                                string="Generate" class="btn-primary"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- The eight menu shortcuts that used to open this form directly
             (one per report_type, docs/05 IA) now open
             `views/fmes_report_dashboard_actions.xml`'s client actions
             instead, which create a wizard record and call
             `action_generate` themselves — see `report_dashboard.js`. This
             form and `action_generate` are still very much in use, just no
             longer reachable as a bare popup of their own. -->

    </data>
</odoo>
