<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         /my/home — a ticket tile alongside the native order/quote ones,
         same pattern sale itself uses for its own tiles.
         ================================================================ -->
    <template id="portal_my_home_ticket" name="Support Tickets"
              customize_show="True" inherit_id="portal.portal_my_home"
              priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Support Tickets</t>
                <t t-set="url" t-value="'/my/tickets'"/>
                <t t-set="text">Raise an issue or follow one already reported</t>
                <t t-set="placeholder_count" t-value="'ticket_count'"/>
            </t>
        </div>
    </template>

    <!-- ================================================================
         /my/tickets — list, own tickets only (controller-side domain,
         backed by the ir.rule in security/fmes_record_rules.xml).
         ================================================================ -->
    <template id="portal_my_tickets" name="My Tickets">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Support Tickets</t>
            </t>

            <div class="mb-3">
                <a href="/my/tickets/new" class="btn btn-primary">
                    <i class="fa fa-plus"/> New Ticket
                </a>
            </div>

            <div t-if="not tickets" class="alert alert-warning" role="alert">
                You have not raised any support tickets yet.
            </div>
            <t t-if="tickets" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>Ticket #</th>
                        <th>Subject</th>
                        <th>Category</th>
                        <th class="text-end">Status</th>
                        <th class="text-end">Raised On</th>
                    </tr>
                </thead>
                <t t-foreach="tickets" t-as="ticket">
                    <tr>
                        <td>
                            <a t-attf-href="/my/tickets/#{ticket.id}">
                                <t t-out="ticket.name"/>
                            </a>
                        </td>
                        <td><t t-out="ticket.subject"/></td>
                        <td><span t-field="ticket.category"/></td>
                        <td class="text-end"><span t-field="ticket.state" widget="badge"/></td>
                        <td class="text-end">
                            <span t-field="ticket.create_date" t-options="{'widget': 'date'}"/>
                        </td>
                    </tr>
                </t>
            </t>
        </t>
    </template>

    <!-- ================================================================
         /my/tickets/new — a plain HTML form; POST creates the ticket
         under the logged-in portal user's own partner, then redirects to
         its detail page.
         ================================================================ -->
    <template id="portal_ticket_new" name="New Support Ticket">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>
            <div class="container">
                <h2>Raise a Support Ticket</h2>
                <form action="/my/tickets/new" method="post" class="mt-3">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <div t-attf-class="mb-3 #{'has-error' if error.get('subject') else ''}">
                        <label class="form-label" for="subject">Subject</label>
                        <input type="text" class="form-control" id="subject" name="subject"
                               t-att-value="form_values.get('subject')" required="required"/>
                        <p t-if="error.get('subject')" class="text-danger mb-0">
                            <t t-out="error['subject']"/>
                        </p>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="category">Category</label>
                        <select class="form-select" id="category" name="category">
                            <t t-foreach="ticket_categories" t-as="cat_key">
                                <option t-att-value="cat_key"
                                        t-att-selected="cat_key == form_values.get('category')">
                                    <t t-out="ticket_categories[cat_key]"/>
                                </option>
                            </t>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="description">Description</label>
                        <textarea class="form-control" id="description" name="description"
                                  rows="5" t-out="form_values.get('description')"/>
                    </div>

                    <a href="/my/tickets" class="btn btn-link">Cancel</a>
                    <button type="submit" class="btn btn-primary">Submit</button>
                </form>
            </div>
        </t>
    </template>

    <!-- ================================================================
         /my/tickets/<id> — detail, with portal.message_thread giving the
         reply UI Odoo's own portal chatter JS already drives (docs/06
         deliverable 6, "list and detail with reply").
         ================================================================ -->
    <template id="portal_ticket_page" name="Support Ticket">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>
            <div class="container">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="mb-0">
                        <t t-out="ticket.name"/> — <t t-out="ticket.subject"/>
                    </h2>
                    <span t-field="ticket.state" widget="badge"/>
                </div>
                <table class="table table-borderless table-sm w-auto">
                    <tbody>
                        <tr>
                            <th class="ps-0">Category:</th>
                            <td><span t-field="ticket.category"/></td>
                        </tr>
                        <tr>
                            <th class="ps-0">Raised On:</th>
                            <td><span t-field="ticket.create_date" t-options="{'widget': 'date'}"/></td>
                        </tr>
                        <tr t-if="ticket.description">
                            <th class="ps-0">Description:</th>
                            <td><span t-field="ticket.description"/></td>
                        </tr>
                        <tr t-if="ticket.resolution">
                            <th class="ps-0">Resolution:</th>
                            <td><span t-field="ticket.resolution"/></td>
                        </tr>
                    </tbody>
                </table>

                <hr/>
                <t t-call="portal.message_thread"/>
            </div>
        </t>
    </template>

    <!-- ================================================================
         Order detail — a "Production Progress" section, line-level,
         showing only produced qty / progress % / expected date (docs/06
         deliverable 4). No machine, cost or downtime data reaches here —
         sale.order.line's own fmes_produced_qty/fmes_progress_pct/
         fmes_expected_date compute (models/sale_order_line.py) are the
         only fields this template ever reads.
         ================================================================ -->
    <template id="portal_order_production_progress"
              name="Order Portal: Production Progress"
              inherit_id="sale.sale_order_portal_content">
        <xpath expr="//div[@id='informations']" position="inside">
            <div id="fmes_production_progress" class="col-12 mb-4"
                 t-if="sale_order.state == 'sale'">
                <h5 class="mb-1">Production Progress</h5>
                <hr class="mt-1 mb-2"/>
                <table class="table table-sm">
                    <thead>
                        <tr class="active">
                            <th>Item</th>
                            <th class="text-end">Ordered</th>
                            <th class="text-end">Produced</th>
                            <th class="text-end">Progress</th>
                            <th class="text-end">Expected</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="sale_order.order_line.filtered(
                                lambda l: not l.display_type)" t-as="line">
                            <tr>
                                <td><t t-out="line.product_id.display_name"/></td>
                                <td class="text-end"><t t-out="'%.2f' % line.product_uom_qty"/></td>
                                <td class="text-end"><t t-out="'%.2f' % line.fmes_produced_qty"/></td>
                                <td class="text-end"><t t-out="'%.1f%%' % line.fmes_progress_pct"/></td>
                                <td class="text-end">
                                    <span t-if="line.fmes_expected_date"
                                          t-field="line.fmes_expected_date"/>
                                    <t t-else="">—</t>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </xpath>
    </template>

</odoo>
