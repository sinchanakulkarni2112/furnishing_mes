<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="furnishing_mes.ShopFloorTerminal">
        <div class="fmes-terminal">

            <!-- ================= machine picker ================= -->
            <t t-if="state.step === 'pick'">
                <div class="fmes-t-header">
                    <div>
                        <h1>Shop Floor Terminal</h1>
                        <div class="fmes-t-sub">
                            <t t-esc="state.userName"/> — choose your machine
                        </div>
                    </div>
                </div>

                <div t-if="state.loading" class="fmes-t-loading">Loading…</div>

                <div t-elif="!state.machines.length" class="fmes-t-empty">
                    <p>No machines are available to you.</p>
                    <p class="fmes-t-sub">
                        Ask your supervisor to assign you to a machine.
                    </p>
                </div>

                <div t-else="" class="fmes-t-machine-grid">
                    <button t-foreach="state.machines" t-as="machine"
                            t-key="machine.id"
                            class="fmes-t-machine"
                            t-on-click="() => this.selectMachine(machine)">
                        <div class="fmes-t-machine-top">
                            <span class="fmes-t-machine-name"
                                  t-esc="machine.name"/>
                            <span t-attf-class="fmes-t-state fmes-t-state-{{machine.state}}"
                                  t-esc="machine.state"/>
                        </div>
                        <div class="fmes-t-machine-code">
                            <t t-esc="machine.code"/>
                            <t t-if="machine.department">
                                · <t t-esc="machine.department"/>
                            </t>
                        </div>
                        <div class="fmes-t-machine-figures">
                            <span><t t-esc="formatNumber(machine.produced)"/></span>
                            <span class="fmes-t-sub">
                                of <t t-esc="formatNumber(machine.target)"/>
                            </span>
                        </div>
                    </button>
                </div>
            </t>

            <!-- ================= work screen ================= -->
            <t t-else="">
                <div class="fmes-t-header">
                    <button class="fmes-t-back" t-on-click="backToMachines">
                        ← Machines
                    </button>
                    <div class="fmes-t-title-block">
                        <h1 t-esc="state.machine.name"/>
                        <div class="fmes-t-sub">
                            <t t-esc="state.machine.code"/>
                            <span t-attf-class="fmes-t-state fmes-t-state-{{state.machine.state}}"
                                  t-esc="state.machine.state"/>
                        </div>
                    </div>
                    <div class="fmes-t-shifts">
                        <button t-foreach="state.shifts" t-as="shift"
                                t-key="shift.id"
                                t-attf-class="fmes-t-shift {{shift.id === state.shiftId ? 'active' : ''}}"
                                t-on-click="() => this.selectShift(shift.id)">
                            <span class="fmes-t-shift-code" t-esc="shift.code"/>
                            <span class="fmes-t-shift-range" t-esc="shift.range"/>
                        </button>
                    </div>
                </div>

                <!-- headline figures -->
                <div class="fmes-t-summary">
                    <div class="fmes-t-stat">
                        <span class="fmes-t-stat-label">Target</span>
                        <span class="fmes-t-stat-value"
                              t-esc="formatNumber(totals.target)"/>
                    </div>
                    <div class="fmes-t-stat">
                        <span class="fmes-t-stat-label">Produced</span>
                        <span class="fmes-t-stat-value fmes-t-strong"
                              t-esc="formatNumber(totals.produced)"/>
                    </div>
                    <div class="fmes-t-stat">
                        <span class="fmes-t-stat-label">Rejected</span>
                        <span class="fmes-t-stat-value"
                              t-esc="formatNumber(totals.rejected)"/>
                    </div>
                    <div class="fmes-t-stat">
                        <span class="fmes-t-stat-label">Achievement</span>
                        <span t-if="totals.hasTarget"
                              t-attf-class="fmes-t-stat-value {{achievementClass(totals.achievement, true)}}">
                            <t t-esc="totals.achievement.toFixed(0)"/>%
                        </span>
                        <span t-else="" class="fmes-t-stat-value fmes-t-neutral">
                            no target
                        </span>
                    </div>
                </div>

                <div t-if="totals.hasTarget" class="fmes-t-progress">
                    <div t-attf-class="fmes-t-progress-bar {{achievementClass(totals.achievement, true)}}"
                         t-attf-style="width: {{barWidth(totals.achievement)}}"/>
                </div>

                <div t-if="state.pendingWrites" class="fmes-t-offline">
                    <t t-esc="state.pendingWrites"/> change(s) could not be saved.
                    Check the network and enter them again.
                </div>

                <!-- entries -->
                <div t-if="state.loading" class="fmes-t-loading">Loading…</div>

                <div t-elif="!state.entries.length" class="fmes-t-empty">
                    <p>Nothing planned for this machine on this shift.</p>
                    <p class="fmes-t-sub">
                        Targets appear here once a plan has been released.
                    </p>
                    <button class="fmes-t-add-product" t-on-click="openProductPicker">
                        + Add a product
                    </button>
                </div>

                <t t-else="">
                <div class="fmes-t-entries-toolbar">
                    <button class="fmes-t-add-product" t-on-click="openProductPicker">
                        + Add a product
                    </button>
                </div>
                <div class="fmes-t-entries">
                    <div t-foreach="state.entries" t-as="entry" t-key="entry.id"
                         t-attf-class="fmes-t-entry {{entry.editable ? '' : 'locked'}}">
                        <div class="fmes-t-entry-head">
                            <span class="fmes-t-product" t-esc="entry.product"/>
                            <span t-attf-class="fmes-t-badge fmes-t-badge-{{entry.state}}"
                                  t-esc="entry.state"/>
                        </div>

                        <div class="fmes-t-fields">
                            <button class="fmes-t-field"
                                    t-on-click="() => this.openKeypad(entry, 'actual_qty', 'Produced')">
                                <span class="fmes-t-field-label">Produced</span>
                                <span class="fmes-t-field-value"
                                      t-esc="formatNumber(entry.actual_qty)"/>
                                <span class="fmes-t-field-hint">
                                    target <t t-esc="formatNumber(entry.planned_qty)"/>
                                </span>
                            </button>

                            <button class="fmes-t-field"
                                    t-on-click="() => this.openKeypad(entry, 'rejected_qty', 'Rejected')">
                                <span class="fmes-t-field-label">Rejected</span>
                                <span class="fmes-t-field-value"
                                      t-esc="formatNumber(entry.rejected_qty)"/>
                            </button>

                            <button class="fmes-t-field"
                                    t-on-click="() => this.openKeypad(entry, 'run_hours', 'Run hours')">
                                <span class="fmes-t-field-label">Run hours</span>
                                <span class="fmes-t-field-value"
                                      t-esc="formatNumber(entry.run_hours)"/>
                            </button>

                            <t t-set="running" t-value="runningEventFor(entry)"/>
                            <button t-if="running"
                                    class="fmes-t-field fmes-t-field-down fmes-t-field-running"
                                    t-on-click="() => this.stopDowntime(entry, running)">
                                <span class="fmes-t-field-label">
                                    <t t-esc="running.loss_name"/>
                                </span>
                                <span class="fmes-t-field-value fmes-t-timer"
                                      t-esc="elapsedLabel(running.date_start)"/>
                                <span class="fmes-t-field-hint">tap to stop</span>
                            </button>
                            <button t-else="" class="fmes-t-field fmes-t-field-down"
                                    t-att-disabled="!entry.editable"
                                    t-on-click="() => this.openDowntimeReasons(entry)">
                                <span class="fmes-t-field-label">Downtime</span>
                                <span class="fmes-t-field-value"
                                      t-esc="formatNumber(entry.downtime_hours)"/>
                                <span class="fmes-t-field-hint">
                                    <t t-esc="entry.downtime_events.length"/> event(s) — tap to log
                                </span>
                            </button>

                            <button class="fmes-t-field"
                                    t-on-click="() => this.openKeypad(entry, 'actual_manpower', 'Operators')">
                                <span class="fmes-t-field-label">Operators</span>
                                <span class="fmes-t-field-value"
                                      t-esc="formatNumber(entry.actual_manpower)"/>
                            </button>

                            <div class="fmes-t-field fmes-t-field-readonly">
                                <span class="fmes-t-field-label">Achievement</span>
                                <span t-if="entry.has_target"
                                      t-attf-class="fmes-t-field-value {{achievementClass(entry.achievement, true)}}">
                                    <t t-esc="entry.achievement.toFixed(0)"/>%
                                </span>
                                <span t-else="" class="fmes-t-field-value fmes-t-neutral">—</span>
                            </div>

                            <button class="fmes-t-field fmes-t-field-materials"
                                    t-on-click="() => this.checkEntryMaterials(entry)">
                                <span class="fmes-t-field-label">Materials</span>
                                <span class="fmes-t-field-value fmes-t-neutral">check</span>
                            </button>
                        </div>
                    </div>
                </div>
                </t>

                <!-- footer -->
                <div class="fmes-t-footer">
                    <div class="fmes-t-footer-info">
                        <span>Downtime today:
                            <strong t-esc="formatNumber(totals.downtime)"/> h</span>
                        <span t-if="lastSyncLabel" class="fmes-t-sub">
                            saved <t t-esc="lastSyncLabel"/>
                        </span>
                    </div>
                    <button class="fmes-t-submit"
                            t-att-disabled="!pendingCount"
                            t-on-click="submitShift">
                        Submit shift
                        <span t-if="pendingCount">
                            (<t t-esc="pendingCount"/>)
                        </span>
                    </button>
                </div>
            </t>

            <!-- ================= numeric keypad ================= -->
            <div t-if="state.keypad" class="fmes-t-keypad-backdrop"
                 t-on-click="closeKeypad">
                <div class="fmes-t-keypad" t-on-click.stop="() => {}">
                    <div class="fmes-t-keypad-head">
                        <div class="fmes-t-keypad-label"
                             t-esc="state.keypad.label"/>
                        <div class="fmes-t-keypad-product"
                             t-esc="state.keypad.product"/>
                    </div>
                    <div class="fmes-t-keypad-display"
                         t-esc="state.keypad.value"/>
                    <div class="fmes-t-keypad-grid">
                        <t t-foreach="['7','8','9','4','5','6','1','2','3','.','0']"
                           t-as="key" t-key="key">
                            <button class="fmes-t-key"
                                    t-on-click="() => this.keypadPress(key)"
                                    t-esc="key"/>
                        </t>
                        <button class="fmes-t-key fmes-t-key-back"
                                t-on-click="() => this.keypadPress('back')">⌫</button>
                    </div>
                    <div class="fmes-t-keypad-actions">
                        <button class="fmes-t-key-clear"
                                t-on-click="() => this.keypadPress('clear')">
                            Clear
                        </button>
                        <button class="fmes-t-key-cancel"
                                t-on-click="closeKeypad">Cancel</button>
                        <button class="fmes-t-key-ok"
                                t-on-click="confirmKeypad">Save</button>
                    </div>
                </div>
            </div>

            <!-- ================= downtime reason picker ================= -->
            <div t-if="state.downtimeModal" class="fmes-t-keypad-backdrop"
                 t-on-click="closeDowntimeModal">
                <div class="fmes-t-downtime-modal" t-on-click.stop="() => {}">

                    <t t-if="state.downtimeModal.step === 'reasons'">
                        <div class="fmes-t-keypad-head">
                            <div class="fmes-t-keypad-label">Log Downtime</div>
                            <div class="fmes-t-keypad-product"
                                 t-esc="state.downtimeModal.entry.product"/>
                        </div>
                        <div class="fmes-t-reason-grid">
                            <t t-foreach="state.downtimeReasons" t-as="group"
                               t-key="group.category">
                                <div class="fmes-t-reason-group-label"
                                     t-esc="group.label"/>
                                <div class="fmes-t-reason-tiles">
                                    <button t-foreach="group.reasons" t-as="reason"
                                            t-key="reason.id"
                                            t-attf-class="fmes-t-reason-tile fmes-t-reason-{{group.category}}"
                                            t-on-click="() => this.pickDowntimeReason(reason)">
                                        <t t-esc="reason.name"/>
                                    </button>
                                </div>
                            </t>
                        </div>
                        <div class="fmes-t-keypad-actions">
                            <button class="fmes-t-key-cancel"
                                    style="grid-column: span 3"
                                    t-on-click="closeDowntimeModal">Cancel</button>
                        </div>
                    </t>

                    <t t-elif="state.downtimeModal.step === 'remark'">
                        <div class="fmes-t-keypad-head">
                            <div class="fmes-t-keypad-label">
                                <t t-esc="state.downtimeModal.reason.name"/>
                            </div>
                            <div class="fmes-t-keypad-product">
                                A note is required for this reason
                            </div>
                        </div>
                        <textarea class="fmes-t-remark-input"
                                  t-model="state.downtimeModal.remarks"
                                  placeholder="What happened?"/>
                        <div class="fmes-t-keypad-actions">
                            <button class="fmes-t-key-cancel"
                                    t-on-click="closeDowntimeModal">Cancel</button>
                            <button class="fmes-t-key-ok" style="grid-column: span 2"
                                    t-on-click="confirmDowntimeRemark">
                                Start
                            </button>
                        </div>
                    </t>

                </div>
            </div>

            <!-- ================= add-product picker ================= -->
            <div t-if="state.productPicker" class="fmes-t-keypad-backdrop"
                 t-on-click="closeProductPicker">
                <div class="fmes-t-product-modal" t-on-click.stop="() => {}">
                    <div class="fmes-t-keypad-head">
                        <div class="fmes-t-keypad-label">Add a Product</div>
                    </div>

                    <div t-if="state.productPicker.loading" class="fmes-t-loading">
                        Loading…
                    </div>
                    <div t-elif="!state.productPicker.products.length" class="fmes-t-empty">
                        <p>No products are set up for this machine.</p>
                    </div>
                    <div t-else="" class="fmes-t-product-list">
                        <button t-foreach="state.productPicker.products" t-as="product"
                                t-key="product.id"
                                t-attf-class="fmes-t-product-row {{state.productPicker.selected and state.productPicker.selected.id === product.id ? 'active' : ''}}"
                                t-on-click="() => this.pickProduct(product)">
                            <t t-esc="product.name"/>
                        </button>
                    </div>

                    <div t-if="state.productPicker.selected" class="fmes-t-material-check">
                        <div t-if="!state.productPicker.materialCheck" class="fmes-t-loading">
                            Checking materials…
                        </div>
                        <t t-elif="state.productPicker.materialCheck.no_bom">
                            <div class="fmes-t-material-line fmes-t-material-neutral">
                                No bill of materials on file for this product —
                                nothing to check.
                            </div>
                        </t>
                        <t t-else="">
                            <div t-attf-class="fmes-t-material-summary {{state.productPicker.materialCheck.all_available ? 'fmes-t-material-ok' : 'fmes-t-material-short'}}">
                                <t t-esc="state.productPicker.materialCheck.all_available ? '✓ Materials available' : '⚠ Some materials are short'"/>
                            </div>
                            <div t-foreach="state.productPicker.materialCheck.components"
                                 t-as="comp" t-key="comp.name"
                                 t-attf-class="fmes-t-material-line {{comp.ok ? 'fmes-t-material-ok' : 'fmes-t-material-short'}}">
                                <span t-esc="comp.ok ? '✓' : '✗'"/>
                                <span t-esc="comp.name"/>
                                <span class="fmes-t-sub">
                                    <t t-esc="formatNumber(comp.available)"/> /
                                    <t t-esc="formatNumber(comp.required)"/>
                                    <t t-esc="comp.uom"/>
                                </span>
                            </div>
                        </t>
                    </div>

                    <div class="fmes-t-keypad-actions">
                        <button class="fmes-t-key-cancel"
                                t-on-click="closeProductPicker">Cancel</button>
                        <button class="fmes-t-key-ok" style="grid-column: span 2"
                                t-att-disabled="!state.productPicker.selected"
                                t-on-click="confirmAddProduct">
                            Add to shift
                        </button>
                    </div>
                </div>
            </div>

            <!-- ================= material check (existing entry) ================= -->
            <div t-if="state.materialModal" class="fmes-t-keypad-backdrop"
                 t-on-click="closeMaterialModal">
                <div class="fmes-t-product-modal" t-on-click.stop="() => {}">
                    <div class="fmes-t-keypad-head">
                        <div class="fmes-t-keypad-label">Materials</div>
                        <div class="fmes-t-keypad-product"
                             t-esc="state.materialModal.product"/>
                    </div>

                    <div t-if="!state.materialModal.result" class="fmes-t-loading">
                        Checking materials…
                    </div>
                    <t t-elif="state.materialModal.result.no_bom">
                        <div class="fmes-t-material-line fmes-t-material-neutral">
                            No bill of materials on file for this product —
                            nothing to check.
                        </div>
                    </t>
                    <t t-else="">
                        <div t-attf-class="fmes-t-material-summary {{state.materialModal.result.all_available ? 'fmes-t-material-ok' : 'fmes-t-material-short'}}">
                            <t t-esc="state.materialModal.result.all_available ? '✓ Materials available' : '⚠ Some materials are short'"/>
                        </div>
                        <div t-foreach="state.materialModal.result.components"
                             t-as="comp" t-key="comp.name"
                             t-attf-class="fmes-t-material-line {{comp.ok ? 'fmes-t-material-ok' : 'fmes-t-material-short'}}">
                            <span t-esc="comp.ok ? '✓' : '✗'"/>
                            <span t-esc="comp.name"/>
                            <span class="fmes-t-sub">
                                <t t-esc="formatNumber(comp.available)"/> /
                                <t t-esc="formatNumber(comp.required)"/>
                                <t t-esc="comp.uom"/>
                            </span>
                        </div>
                    </t>

                    <div class="fmes-t-keypad-actions">
                        <button class="fmes-t-key-ok" style="grid-column: span 3"
                                t-on-click="closeMaterialModal">Close</button>
                    </div>
                </div>
            </div>

            <!-- ================= submit: downtime question ================= -->
            <div t-if="state.submitConfirm" class="fmes-t-keypad-backdrop"
                 t-on-click="cancelSubmit">
                <div class="fmes-t-product-modal" t-on-click.stop="() => {}">
                    <div class="fmes-t-keypad-head">
                        <div class="fmes-t-keypad-label">
                            Did you face any downtime this shift?
                        </div>
                        <div class="fmes-t-keypad-product">
                            Submitting <t t-esc="state.submitConfirm.editableCount"/> entr<t
                                t-esc="state.submitConfirm.editableCount === 1 ? 'y' : 'ies'"/>
                            for approval
                        </div>
                    </div>
                    <div class="fmes-t-keypad-actions">
                        <button class="fmes-t-key-cancel"
                                t-on-click="() => this.answerSubmit(false)">
                            No
                        </button>
                        <button class="fmes-t-key-ok" style="grid-column: span 2"
                                t-on-click="() => this.answerSubmit(true)">
                            Yes — log it after submitting
                        </button>
                    </div>
                </div>
            </div>

            <!-- ================= post-submit: which product? ================= -->
            <div t-if="state.postSubmitPicker" class="fmes-t-keypad-backdrop"
                 t-on-click="closePostSubmitPicker">
                <div class="fmes-t-product-modal" t-on-click.stop="() => {}">
                    <div class="fmes-t-keypad-head">
                        <div class="fmes-t-keypad-label">Which product had downtime?</div>
                    </div>
                    <div class="fmes-t-product-list">
                        <button t-foreach="state.postSubmitPicker.entries" t-as="entry"
                                t-key="entry.id"
                                class="fmes-t-product-row"
                                t-on-click="() => this.choosePostSubmitEntry(entry)">
                            <t t-esc="entry.product"/>
                        </button>
                    </div>
                    <div class="fmes-t-keypad-actions">
                        <button class="fmes-t-key-cancel" style="grid-column: span 3"
                                t-on-click="closePostSubmitPicker">
                            Skip
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
