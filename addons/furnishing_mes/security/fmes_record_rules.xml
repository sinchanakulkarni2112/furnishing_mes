        <!--
            Department-scoped rules for supervisors, promised above since
            Phase 1 and delivered here for this phase's own two new models
            (res.users.fmes_department_ids has existed since Phase 4). Not
            retrofitted onto earlier phases' models in this same commit —
            that is a larger, separate exercise noted in MEMORY.md rather
            than folded into this one.

            An empty fmes_department_ids means "responsible for all
            departments" (the field's own help text), so the domain is a
            genuine Python conditional, not a domain clause — evaluated by
            ir.rule the same way the existing rules already use `user` and
            `company_ids`.

            Both models need the SAME explicit-unrestricted-manager pattern
            D5.3 established: group_fmes_manager implies group_fmes_supervisor,
            so without its own unrestricted rule a Plant Manager would be
            caught by the department-scoped supervisor rule too.
        -->
        <record id="fmes_manpower_log_company_rule" model="ir.rule">
            <field name="name">Manpower Log: multi-company</field>
            <field name="model_id" ref="model_fmes_manpower_log"/>
