        <!--
            Phase 13 — Customer Portal. Both rules below are non-global,
            attached only to base.group_portal: internal users (operator /
            supervisor / manager) are never members of that group — a
            completely separate branch of Odoo's own group tree from
            group_fmes_* — so neither rule narrows what an internal user
            can see (the D5.3 cumulative-hierarchy gotcha does not apply
            here, unlike every other department-scoping rule in this file).
        -->
        <record id="fmes_support_ticket_portal_rule" model="ir.rule">
            <field name="name">Support Ticket: portal customer sees own tickets only</field>
            <field name="model_id" ref="model_fmes_support_ticket"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">
                [('partner_id', 'child_of', [user.commercial_partner_id.id])]
            </field>
        </record>

        <record id="fmes_mrp_production_portal_rule" model="ir.rule">
            <field name="name">Manufacturing Order: portal customer sees own orders only</field>
            <field name="model_id" ref="mrp.model_mrp_production"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">
                [('sale_line_id.order_id.partner_id', 'child_of', [user.commercial_partner_id.id])]
            </field>
        </record>

        <!--
            Phase 14 audit finding. maintenance.equipment ships two native,
            non-global rules: a follower-based one for base.group_user (any
            internal user, unrestricted otherwise) and an unrestricted one
            for group_equipment_manager. An Operator is neither a follower
            of a machine's equipment record by default nor a member of
            group_equipment_manager (only Supervisor+ is), so real machine
            records were silently unreadable — the exact same class of gap
            already documented once for this same model as D7.1 (a
            targeted .sudo() fixed the health-score COMPUTE path back then;
            this closes the same gap for direct read access generally,
            matching docs/04-security-model.md's own permission matrix,
            which promises Operator plain R on maintenance.equipment).
        -->
        <record id="fmes_maintenance_equipment_operator_rule" model="ir.rule">
            <field name="name">Equipment: operator can read every machine's equipment record</field>
            <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
            <field name="groups" eval="[(4, ref('furnishing_mes.group_fmes_operator'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>
</odoo>
