            <field name="model_id" ref="model_fmes_manpower_log"/>
            <field name="groups" eval="[(4, ref('furnishing_mes.group_fmes_supervisor'))]"/>
            <field name="domain_force">
                [('department_id', 'in', user.fmes_department_ids.ids)] if user.fmes_department_ids else [(1, '=', 1)]
