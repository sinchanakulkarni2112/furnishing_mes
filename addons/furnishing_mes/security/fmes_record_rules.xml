        <!--
            Operator scoping on production entries.

            Two rules, because reading and writing need different limits:

            READ  — the machines the operator is assigned to, plus anything
                    they recorded themselves. An operator with no machine
                    assignment therefore sees only their own work rather than
                    the whole plant.
            WRITE — their own entries, and only while still draft. Once a shift
                    is submitted it stops being theirs to change.

            Supervisors and above are not subject to either: they hold their own
            group's rules, and Odoo applies the union of the rules a user's
            groups grant.
        -->
        <record id="fmes_entry_operator_read_rule" model="ir.rule">
            <field name="name">Production Entry: operator sees own machines</field>
            <field name="model_id" ref="model_fmes_production_entry"/>
            <field name="groups" eval="[(4, ref('furnishing_mes.group_fmes_operator'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">
                ['|',
                 ('create_uid', '=', user.id),
                 ('workcenter_id', 'in', user.fmes_allowed_workcenter_ids.ids)]
            </field>
        </record>

        <record id="fmes_entry_operator_write_rule" model="ir.rule">
            <field name="name">Production Entry: operator edits own drafts</field>
            <field name="model_id" ref="model_fmes_production_entry"/>
            <field name="groups" eval="[(4, ref('furnishing_mes.group_fmes_operator'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <!--
                Phase 14 audit finding: the workcenter scope was missing
                here entirely, so any operator could write to any OTHER
                operator's draft/submitted/rejected entry on any machine,
                not just their own allocated ones — the read rule already
                got this right (below); this one did not. create_uid=self
                in the OR is what keeps an operator's own CREATE working
                even with no machine scope configured at all (the model's
                own "not locked out" default, res_users.py's docstring):
                a record's create_uid is always the creating user, so that
                branch is always true for something they just made,
                regardless of workcenter — only a WRITE to someone ELSE's
                entry is actually workcenter-gated by this change.
            -->
            <field name="domain_force">
                [('state', 'in', ('draft', 'submitted', 'rejected')),
                 '|', ('create_uid', '=', user.id),
                      ('workcenter_id', 'in', user.fmes_allowed_workcenter_ids.ids)]
            </field>
        </record>

        <record id="fmes_entry_supervisor_rule" model="ir.rule">
            <field name="name">Production Entry: supervisor sees everything</field>
            <field name="model_id" ref="model_fmes_production_entry"/>
            <field name="groups" eval="[(4, ref('furnishing_mes.group_fmes_supervisor'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="fmes_downtime_report_company_rule" model="ir.rule">
            <field name="name">Downtime Report: multi-company</field>
            <field name="model_id" ref="model_fmes_downtime_report"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>

        <!--
            Operator scoping on downtime events, mirroring the two-rule split
            used for fmes.production.entry in Phase 4: reading follows the
            machines the operator is assigned to (or their own creation),
            writing is limited to still-open records regardless of machine.

            A Supervisor and a Plant Manager ALSO hold group_fmes_operator,
            because Phase 1's role hierarchy is cumulative (implied_ids): a
            Supervisor implies Operator, a Manager implies Supervisor. Odoo
            evaluates a non-global ir.rule against every group a user belongs
            to, including implied ones — so the operator rules below would
            silently apply to supervisors and managers too, with no other
            non-global rule on this model to OR against and widen it back
            out. mrp.group_mrp_user's native ACL grants the base RWCD
            permission, but that is a different layer (ACL, not ir.rule) and
            does not exempt anyone from an ir.rule domain.
            An explicit, unrestricted rule for group_fmes_supervisor is what
            fixes this — found by a real AccessError when a Plant Manager
            (who is also, transitively, an Operator) tried to reopen an
            approved event and was refused read access to their own record.
        -->
        <record id="fmes_productivity_supervisor_rule" model="ir.rule">
            <field name="name">Downtime Event: supervisor sees everything</field>
            <field name="model_id" ref="mrp.model_mrp_workcenter_productivity"/>
            <field name="groups" eval="[(4, ref('furnishing_mes.group_fmes_supervisor'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="fmes_productivity_operator_read_rule" model="ir.rule">
            <field name="name">Downtime Event: operator sees own machines</field>
            <field name="model_id" ref="mrp.model_mrp_workcenter_productivity"/>
            <field name="groups" eval="[(4, ref('furnishing_mes.group_fmes_operator'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">
                ['|',
                 ('create_uid', '=', user.id),
                 ('workcenter_id', 'in', user.fmes_allowed_workcenter_ids.ids)]
            </field>
        </record>

        <record id="fmes_productivity_operator_write_rule" model="ir.rule">
            <field name="name">Downtime Event: operator edits own drafts</field>
            <field name="model_id" ref="mrp.model_mrp_workcenter_productivity"/>
            <field name="groups" eval="[(4, ref('furnishing_mes.group_fmes_operator'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
            <!-- Phase 14 audit finding: same gap and same fix as
                 fmes_entry_operator_write_rule above — see its comment. -->
            <field name="domain_force">
                [('fmes_state', 'in', ('draft', 'rejected')),
                 '|', ('create_uid', '=', user.id),
                      ('workcenter_id', 'in', user.fmes_allowed_workcenter_ids.ids)]
            </field>
        </record>

        <record id="fmes_utilization_report_company_rule" model="ir.rule">
            <field name="name">Utilisation Report: multi-company</field>
            <field name="model_id" ref="model_fmes_utilization_report"/>
