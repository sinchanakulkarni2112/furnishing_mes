# Everything that is bind-mounted into the Linux container must keep LF endings.
# Without this, a clone on Windows converts these files to CRLF and the Makefile
# and shell scripts break inside the container.
* text=auto eol=lf

# Explicit, for the files that matter most
*.py       text eol=lf
*.xml      text eol=lf
*.csv      text eol=lf
*.conf     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.sh       text eol=lf
*.md       text eol=lf
Makefile   text eol=lf
.env.example text eol=lf

# Binary assets — never touch these
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.xlsx binary
*.zip  binary
*.woff  binary
*.woff2 binary
