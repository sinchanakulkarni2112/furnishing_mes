# ============================================================================
#  Furnishing MES — environment configuration
# ============================================================================
#  Copy this file to .env and set real values:
#
#      cp .env.example .env
#
#  .env is git-ignored and must never be committed.
# ============================================================================

# ─────────────────────────────────────────────────────────── PostgreSQL ─────
# The maintenance database the postgres image creates on first boot.
# Odoo creates its own database (ODOO_DB) alongside it.
POSTGRES_DB=postgres
POSTGRES_USER=odoo

# REQUIRED. The stack refuses to start if this is unset — deliberately, so it
# can never boot on a well-known default password.
POSTGRES_PASSWORD=change_me_to_a_strong_password

# ───────────────────────────────────────────────────────────────── Odoo ─────
# Name of the Odoo database. Used by the Makefile targets.
ODOO_DB=furnishing_mes

# Host interface the Odoo port is published on.
#   127.0.0.1  — default. Reachable only from this machine.
#   0.0.0.0    — reachable from the LAN. Use when testing on a shop-floor
#                tablet or phone, and only on a trusted network.
ODOO_BIND=127.0.0.1

ODOO_PORT=8069
ODOO_LONGPOLL_PORT=8072

# ────────────────────────────────────────────────────────────────── Note ────
# The Odoo master password (admin_passwd) is NOT set here. Odoo 18 has no
# command-line option for it, so it can only live in config/odoo.conf. The
# committed development value is an explicit placeholder; production generates
# a strong one into a git-ignored config file (Phase 15).
